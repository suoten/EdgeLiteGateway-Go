# ─────────────────────────────────────────────────────────────────────
# EdgeLite Gateway Docker Environment Configuration
# Copy to .env and modify values for your deployment
# ─────────────────────────────────────────────────────────────────────

# ── Security (REQUIRED) ──────────────────────────────────────────────
# Generate a random 32+ character string: openssl rand -base64 48
SECRET_KEY=change-me-to-a-random-32-char-secret-key!!!

# ── InfluxDB ─────────────────────────────────────────────────────────
INFLUXDB_USERNAME=edgelite
INFLUXDB_PASSWORD=Edgelite@InfluxDB2024
INFLUXDB_TOKEN=edgelite-influxdb-token-change-me

# ── MQTT ─────────────────────────────────────────────────────────────
MQTT_PASSWORD=Edgelite@MQTT2024

# ── Grafana ──────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Admin@Grafana2024
