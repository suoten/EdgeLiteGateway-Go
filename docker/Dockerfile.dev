# Development Dockerfile: Go backend only (no frontend build)
FROM golang:1.22-alpine AS backend-builder

RUN apk add --no-cache gcc musl-dev

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -ldflags="-s -w -X main.Version=1.0.0-go-dev" -o /edgelite ./cmd/edgelite/

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata wget \
    && addgroup -S appuser \
    && adduser -S -G appuser appuser

WORKDIR /app

COPY --from=backend-builder /edgelite /app/edgelite
COPY configs/ /app/configs/

RUN mkdir -p data/backups data/logs \
    && chown -R appuser:appuser /app

USER appuser

ENV EDGELITE_CONFIG=configs/config.yaml
ENV EDGELITE_SERVER__HOST=0.0.0.0
ENV EDGELITE_SERVER__PORT=8080

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=10s \
    CMD wget --spider -q http://localhost:8080/health/live || exit 1

ENTRYPOINT ["/app/edgelite"]
CMD ["--host", "0.0.0.0", "--port", "8080"]
