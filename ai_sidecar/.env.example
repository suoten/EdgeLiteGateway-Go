# EdgeLite AI Sidecar Environment Configuration
# Copy this file to .env and adjust values as needed

# Server settings
AI_SIDECAR_HOST=0.0.0.0
AI_SIDECAR_PORT=50052
AI_MODELS_DIR=models

# Logging
AI_SIDECAR_LOG_LEVEL=INFO
# Set to 1 for structured JSON logs (recommended for containerised deployments)
AI_SIDECAR_JSON_LOGS=1

# Inference configuration (optional overrides)
# AI_SIDECAR_INFERENCE_TIMEOUT=5.0
# AI_SIDECAR_SCHEDULED_INTERVAL=60
